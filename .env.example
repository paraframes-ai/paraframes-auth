# Copy to .env for local development. docker-compose sets these directly.

APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080

# Postgres connection string.
DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable

# Access / refresh token lifetimes (Go duration syntax).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# JWT signing. In production supply a PEM-encoded EC (P-256) private key.
# Generate one with: openssl ecparam -name prime256v1 -genkey -noout -out ec.pem
# Then: JWT_PRIVATE_KEY_PEM="$(cat ec.pem)"
JWT_PRIVATE_KEY_PEM=
JWT_KEY_ID=auth-key-1
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=paraframes-app

# Social login. Comma-separated accepted audiences (client/bundle/service IDs).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# WebAuthn / passkeys.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Paraframes
WEBAUTHN_RP_ORIGINS=http://localhost:8080,http://localhost:5173

# Beta gating: the code users submit to POST /v1/beta/enroll to unlock passkeys.
BETA_ACCESS_CODE=paraframes-beta

# Email (SMTP). Leave SMTP_HOST empty to log emails to the console in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@paraframes.local

# CORS. Comma-separated origins, or * for all.
CORS_ALLOWED_ORIGINS=*

# Argon2id password hashing parameters.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Rate limiting on auth endpoints (per client IP).
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
